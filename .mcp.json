{
  "mcpServers": {
    "MCP_DOCKER": {
      "command": "docker",
      "args": ["mcp", "gateway", "run", "--profile", "portfolio-ops-copilot"],
      "env": {
        "LOCALAPPDATA": "<ABSOLUTE_PATH_TO_LOCALAPPDATA>",
        "ProgramData": "C:\\ProgramData",
        "ProgramFiles": "C:\\Program Files",
        "MCP_GATEWAY_DOCKER_BIND_ALLOWED_PATHS": "<ABSOLUTE_PATH_TO_REPO>/data/synthetic"
      },
      "type": "stdio"
    }
  }
}
